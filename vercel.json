{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "admin/index.html", "use": "@vercel/static" },
    { "src": "admin/favicon.svg", "use": "@vercel/static" },
    { "src": "dashboard.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/admin", "dest": "/admin/index.html" },
    { "src": "/admin/favicon.svg", "dest": "/admin/favicon.svg" },
    { "src": "/dashboard.html", "dest": "/dashboard.html" },
    { "src": "/(.*)", "dest": "api/index.js" }
  ]
}
